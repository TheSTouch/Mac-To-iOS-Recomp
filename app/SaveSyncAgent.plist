<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Recomp Helper's background item (SaveSync.swift): an idle process that copies the
     synced games' saves between their Mac folders and iCloud Drive when a game quits,
     when iCloud Drive/Recomp Saves changes, and hourly. Copied by
     scripts/build-app.sh to Contents/Library/LaunchAgents/. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.thestouch.recomphelper.saves</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/RecompHelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>RecompHelper</string>
		<string>--sync-saves</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>io.github.thestouch.recomphelper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
</dict>
</plist>
