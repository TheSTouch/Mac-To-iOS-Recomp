#!/usr/bin/env python3
"""Strip Claude co-author trailers so Claude never shows up as a contributor.

Removes "Co-Authored-By: Claude ..." and "Co-Authored-By: ... <noreply@anthropic.com>"
lines and the "Generated with Claude Code" footer from the commit message.

Enable once per clone:  git config core.hooksPath .githooks
"""
import re
import sys

CLAUDE_LINE = re.compile(
    r"^\s*(co-authored-by:.*(claude|anthropic\.com).*"
    r"|.*generated with \[?claude code\]?.*)$",
    re.IGNORECASE)


def main():
    path = sys.argv[1]
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    kept = [line for line in lines if not CLAUDE_LINE.match(line)]
    while kept and not kept[-1].strip():
        kept.pop()
    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(kept) + "\n")


if __name__ == "__main__":
    main()
