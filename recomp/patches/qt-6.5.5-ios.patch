+// SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#ifndef QIOSNUMBERPAD_H
+#define QIOSNUMBERPAD_H
+
+#import <UIKit/UIKit.h>
+
+#include <QtCore/qnamespace.h>
+
+@class QIOSTextInputResponder;
+
+// The iPad's number pad for number inputs: a small panel by the field, drawn by the
+// app above its windows. iPadOS's own (a popover by the caret, drawn by the keyboard
+// process) is swapped for the docked keyboard about a second after a tap focuses
+// the field, with no call into the app in between.
+@interface QIOSNumberPad : UIView
+
++ (BOOL)wantedForHints:(Qt::InputMethodHints)hints;
+
+// From the responder becoming and resigning first responder.
++ (void)showForResponder:(QIOSTextInputResponder *)responder decimal:(BOOL)decimal;
++ (void)hideForResponder:(QIOSTextInputResponder *)responder;
+
+// A pad kept on screen for a responder that then never came (a touch that left the input).
++ (void)hideIfUnused;
+
+// The input moved.
++ (void)updatePosition;
+
+// A popup (a menu, a combo box's list) opened or closed: the pad, drawn above the app's
+// windows, is hidden while one shows.
++ (void)popupsChanged;
+
+@end
+
+#endif // QIOSNUMBERPAD_H
diff --git a/qtbase-everywhere-src-6.5.5/src/plugins/platforms/ios/qiosnumberpad.mm b/qtbase-everywhere-src-6.5.5/src/plugins/platforms/ios/qiosnumberpad.mm
new file mode 100644
--- /dev/null
+++ b/qtbase-everywhere-src-6.5.5/src/plugins/platforms/ios/qiosnumberpad.mm
@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: LGPL-3.0-only OR GPL-2.0-only OR GPL-3.0-only
+
+#include "qiosnumberpad.h"
+
+#import <GameController/GameController.h>
+
+#include "qiosglobal.h"
+#include "qiostextresponder.h"
+#include "qiosviewcontroller.h"
+#include "quiview.h"
+
+#include <QtCore/qlocale.h>
+#include <QtGui/qguiapplication.h>
+#include <QtGui/qinputmethod.h>
+#include <QtGui/qwindow.h>
+
+// Sizes in points, like the system keyboard's keys.
+static const CGFloat kKeyWidth = 56;
+static const CGFloat kKeyHeight = 44;
+static const CGFloat kGap = 6;
+static const CGFloat kMargin = 8;
+static const CGFloat kFromInput = 6; // between the pad and the input
+
+static UIColor *keyboardColor(CGFloat light, CGFloat dark)
+{
+    return [UIColor colorWithDynamicProvider:^UIColor *(UITraitCollection *traits) {
+        return [UIColor colorWithWhite:traits.userInterfaceStyle == UIUserInterfaceStyleDark ? dark : light alpha:1];
+    }];
+}
+
+@interface QIOSNumberPadKey : UIButton
+@property (nonatomic, retain) UIColor *normalColor;
+@property (nonatomic, retain) UIColor *pressedColor;
+@end
+
+@implementation QIOSNumberPadKey
+
+- (void)dealloc
+{
+    [_normalColor release];
+    [_pressedColor release];
+    [super dealloc];
+}
+
+- (void)setHighlighted:(BOOL)highlighted
+{
+    [super setHighlighted:highlighted];
+    self.backgroundColor = highlighted ? self.pressedColor : self.normalColor;
+}
+
+@end
+
+static QIOSNumberPad *s_numberPad = nil;
+
+static bool popupShowing()
+{
+    for (QWindow *window : QGuiApplication::topLevelWindows())
+        if (window->type() == Qt::Popup && window->isVisible())
+            return true;
+    return false;
+}
+
+@implementation QIOSNumberPad {
+    QIOSTextInputResponder *m_responder; // the one the keys type into, retained
+    BOOL m_decimal;
+    QIOSNumberPadKey *m_zero;
+    QIOSNumberPadKey *m_separator;
+    NSTimer *m_repeat;
+}
+
++ (BOOL)wantedForHints:(Qt::InputMethodHints)hints
+{
+    return UIDevice.currentDevice.userInterfaceIdiom == UIUserInterfaceIdiomPad
+        && (hints & (Qt::ImhDigitsOnly | Qt::ImhFormattedNumbersOnly));
+}
+
++ (void)showForResponder:(QIOSTextInputResponder *)responder decimal:(BOOL)decimal
+{
+    if (!s_numberPad)
+        s_numberPad = [[QIOSNumberPad alloc] init];
+    [s_numberPad attach:responder decimal:decimal];
+}
+
++ (void)hideForResponder:(QIOSTextInputResponder *)responder
+{
+    if (!s_numberPad || s_numberPad->m_responder != responder)
+        return;
+    [s_numberPad detach];
+    // A tap on another number input: its responder waits for the finger to lift
+    // (QIOSInputContext::update()) and the pad then moves there, instead of going
+    // away and coming back.
+    UIResponder *next = FirstResponderCandidate::currentCandidate();
+    if ([next isKindOfClass:[QIOSTextInputResponder class]]
+        && static_cast<QIOSTextInputResponder *>(next).usesNumberPad)
+        return;
+    [s_numberPad fadeOut];
+}
+
++ (void)hideIfUnused
+{
+    if (s_numberPad && !s_numberPad->m_responder)
+        [s_numberPad fadeOut];
+}
+
++ (void)updatePosition
+{
+    if (s_numberPad && s_numberPad->m_responder && !s_numberPad.hidden)
+        [s_numberPad place:YES];
+}
+
++ (void)popupsChanged
+{
+    // Once the window's visibility has settled.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [s_numberPad refresh];
+    });
+}
+
+- (instancetype)init
+{
+    if (!(self = [super initWithFrame:CGRectMake(0, 0, 2 * kMargin + 3 * kKeyWidth + 2 * kGap,
+                                                 2 * kMargin + 5 * kKeyHeight + 4 * kGap)]))
+        return self;
+
+    self.hidden = YES;
+    self.alpha = 0;
+    self.backgroundColor = keyboardColor(0.82, 0.17);
+    self.layer.cornerRadius = 12;
+    self.layer.shadowColor = UIColor.blackColor.CGColor;
+    self.layer.shadowOpacity = 0.3;
+    self.layer.shadowRadius = 12;
+    self.layer.shadowOffset = CGSizeMake(0, 4);
+
+    UIColor *digit = keyboardColor(1.0, 0.42);
+    UIColor *function = keyboardColor(0.67, 0.27);
+    // A key at x (in key widths), on a row, so many key widths wide.
+    const auto key = [&](CGFloat x, int row, CGFloat keys, NSString *name, NSString *symbol, NSString *label,
+                         UIColor *normal, UIColor *pressed, SEL action) {
+        QIOSNumberPadKey *button = [QIOSNumberPadKey buttonWithType:UIButtonTypeCustom];
+        button.frame = CGRectMake(kMargin + x * (kKeyWidth + kGap), kMargin + row * (kKeyHeight + kGap),
+                                  keys * kKeyWidth + (keys - 1) * kGap, kKeyHeight);
+        button.normalColor = normal;
+        button.pressedColor = pressed;
+        button.backgroundColor = normal;
+        button.layer.cornerRadius = 6;
+        button.layer.shadowColor = UIColor.blackColor.CGColor;
+        button.layer.shadowOpacity = 0.25;
+        button.layer.shadowRadius = 0;
+        button.layer.shadowOffset = CGSizeMake(0, 1);
+        if (symbol) {
+            UIImageSymbolConfiguration *size = [UIImageSymbolConfiguration configurationWithPointSize:20];
+            [button setImage:[UIImage systemImageNamed:symbol withConfiguration:size] forState:UIControlStateNormal];
+            button.tintColor = UIColor.labelColor;
+            button.accessibilityLabel = label;
+        } else {
+            [button setTitle:name forState:UIControlStateNormal];
+            [button setTitleColor:UIColor.labelColor forState:UIControlStateNormal];
+            button.titleLabel.font = [UIFont systemFontOfSize:24];
+        }
+        button.accessibilityIdentifier = [@"numberpad." stringByAppendingString:name];
+        if (action)
+            [button addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+        [self addSubview:button];
+        return button;
+    };
+
+    for (int n = 1; n <= 9; ++n)
+        key((n - 1) % 3, 2 - (n - 1) / 3, 1, [NSString stringWithFormat:@"%d", n], nil, nil, digit, function,
+            @selector(typeKey:));
+    key(0, 3, 1, @"sign", @"plus.forwardslash.minus", @"Change sign", function, digit, @selector(toggleSign));
+    m_zero = key(1, 3, 1, @"0", nil, nil, digit, function, @selector(typeKey:));
+    m_separator = key(2, 3, 1, @"separator", nil, nil, digit, function, @selector(typeKey:)); // titled in attach
+
+    // Delete and Done share the last row, half each.
+    QIOSNumberPadKey *erase = key(0, 4, 1.5, @"delete", @"delete.left", @"Delete", function, digit, nil);
+    [erase addTarget:self action:@selector(startRepeat) forControlEvents:UIControlEventTouchDown];
+    [erase addTarget:self action:@selector(stopRepeat)
+          forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel];
+    QIOSNumberPadKey *done = key(1.5, 4, 1.5, @"done", nil, nil,
+                                 UIColor.systemBlueColor, function, @selector(done));
+    [done setTitle:NSLocalizedString(@"Done", nil) forState:UIControlStateNormal];
+    [done setTitleColor:UIColor.whiteColor forState:UIControlStateNormal];
+    done.titleLabel.font = [UIFont systemFontOfSize:18 weight:UIFontWeightSemibold];
+
+    [NSNotificationCenter.defaultCenter addObserver:self selector:@selector(refresh)
+                                               name:GCKeyboardDidConnectNotification object:nil];
+    [NSNotificationCenter.defaultCenter addObserver:self selector:@selector(refresh)
+                                               name:GCKeyboardDidDisconnectNotification object:nil];
+    return self;
+}
+
+- (void)dealloc
+{
+    [NSNotificationCenter.defaultCenter removeObserver:self];
+    [m_repeat invalidate];
+    [m_responder release];
+    [super dealloc];
+}
+
+- (void)attach:(QIOSTextInputResponder *)responder decimal:(BOOL)decimal
+{
+    if (m_responder != responder) {
+        [m_responder release];
+        m_responder = [responder retain];
+    }
+    m_decimal = decimal;
+
+    // Integers have no separator: their 0 takes its place too.
+    m_separator.hidden = !decimal;
+    [m_separator setTitle:QLocale().decimalPoint().toNSString() forState:UIControlStateNormal];
+    CGRect zero = m_zero.frame;
+    zero.size.width = decimal ? kKeyWidth : 2 * kKeyWidth + kGap;
+    m_zero.frame = zero;
+
+    // A hardware keyboard types the numbers.
+    if (GCKeyboard.coalescedKeyboard || popupShowing()) {
+        [self fadeOut];
+        return;
+    }
+
+    QWindow *window = qGuiApp->focusWindow();
+    UIView *root = window && window->handle()
+        ? reinterpret_cast<UIView *>(window->winId()).qtViewController.view : nil;
+    if (!root)
+        return;
+    if (self.superview != root) {
+        self.hidden = YES;
+        [root addSubview:self];
+    }
+    [root bringSubviewToFront:self];
+    // Once Qt has moved the input method's rectangles to the new input.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (m_responder != responder)
+            return;
+        [self place:!self.hidden];
+        self.hidden = NO;
+        [UIView animateWithDuration:0.15 delay:0 options:UIViewAnimationOptionBeginFromCurrentState
+                         animations:^{ self.alpha = 1; } completion:nil];
+    });
+}
+
+- (void)detach
+{
+    [self stopRepeat];
+    [m_responder release];
+    m_responder = nil;
+}
+
+- (void)fadeOut
+{
+    if (self.hidden)
+        return;
+    [UIView animateWithDuration:0.1 delay:0 options:UIViewAnimationOptionBeginFromCurrentState
+                     animations:^{ self.alpha = 0; }
+                     completion:^(BOOL finished) {
+                         if (finished)
+                             self.hidden = YES;
+                     }];
+}
+
+// Under the input, or above it when there is no room below, centred on it and kept
+// inside the safe area.
+- (void)place:(BOOL)animated
+{
+    UIView *root = self.superview;
+    QWindow *window = qGuiApp->focusWindow();
+    if (!root || !window || !window->handle())
+        return;
+    QRectF item = qGuiApp->inputMethod()->inputItemClipRectangle();
+    if (item.isEmpty())
+        item = qGuiApp->inputMethod()->cursorRectangle();
+    UIView *view = reinterpret_cast<UIView *>(window->winId());
+    const CGRect input = [view convertRect:item.toCGRect() toView:root];
+    const CGRect area = UIEdgeInsetsInsetRect(root.bounds, root.safeAreaInsets);
+    const CGSize size = self.bounds.size;
+
+    CGFloat y = CGRectGetMaxY(input) + kFromInput;
+    if (y + size.height > CGRectGetMaxY(area) - kMargin)
+        y = CGRectGetMinY(input) - kFromInput - size.height;
+    // An input scrolled partly out of sight, or too tall to have room either side.
+    y = qBound(CGRectGetMinY(area) + kMargin, y, CGRectGetMaxY(area) - kMargin - size.height);
+    CGFloat x = CGRectGetMidX(input) - size.width / 2;
+    x = qBound(CGRectGetMinX(area) + kMargin, x, CGRectGetMaxX(area) - kMargin - size.width);
+
+    const CGPoint center = CGPointMake(x + size.width / 2, y + size.height / 2);
+    if (CGPointEqualToPoint(center, self.center))
+        return;
+    if (animated)
+        [UIView animateWithDuration:0.2 delay:0 options:UIViewAnimationOptionBeginFromCurrentState
+                         animations:^{ self.center = center; } completion:nil];
+    else
+        self.center = center;
+}
+
+// A hardware keyboard or a popup came or went.
+- (void)refresh
+{
+    if (m_responder && [m_responder isFirstResponder])
+        [self attach:m_responder decimal:m_decimal];
+}
+
+- (void)typeKey:(UIButton *)key
+{
+    [m_responder insertText:[key titleForState:UIControlStateNormal]];
+}
+
+- (void)toggleSign
+{
+    [m_responder qt_toggleSign];
+}
+
+- (void)startRepeat
+{
+    [m_responder deleteBackward];
+    [m_repeat invalidate];
+    m_repeat = [NSTimer scheduledTimerWithTimeInterval:0.45 repeats:NO block:^(NSTimer *) {
+        m_repeat = [NSTimer scheduledTimerWithTimeInterval:0.08 repeats:YES block:^(NSTimer *) {
+            [m_responder deleteBackward];
+        }];
+    }];
+}
+
+- (void)stopRepeat
+{
+    [m_repeat invalidate];
+    m_repeat = nil;
+}
+
+- (void)done
+{
+    [m_responder resignFirstResponder];
+}
+
+@end
