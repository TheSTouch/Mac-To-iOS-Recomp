<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built at port time (recomp/unity_ios.py) against the game and the port's shims:
       dotnet build -p:GameManaged=<Data/Managed> -p:RecompShims=<work>/shims -p:RecompHarmony=<work>/harmony -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Recomp.TheSTouchscreen</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <GameAssembly Include="$(GameManaged)/Bindito.Core.dll;$(GameManaged)/Timberborn.SingletonSystem.dll;$(GameManaged)/Timberborn.ToolSystem.dll;$(GameManaged)/Timberborn.InputSystem.dll;$(GameManaged)/Timberborn.KeyBindingSystem.dll;$(GameManaged)/Timberborn.CameraSystem.dll;$(GameManaged)/Timberborn.Debugging.dll;$(GameManaged)/Timberborn.DebuggingUI.dll;$(GameManaged)/Timberborn.UILayoutSystem.dll;$(GameManaged)/Timberborn.CoreUI.dll;$(GameManaged)/Timberborn.BlockObjectTools.dll;$(GameManaged)/Timberborn.BlockSystem.dll;$(GameManaged)/Timberborn.BlueprintSystem.dll;$(GameManaged)/UnityEngine.CoreModule.dll;$(GameManaged)/UnityEngine.UIElementsModule.dll;$(GameManaged)/UnityEngine.TextRenderingModule.dll;$(RecompShims)/Recomp.TouchMouse.dll;$(RecompHarmony)/0Harmony.dll" />
    <Reference Include="@(GameAssembly)" Private="false" />
  </ItemGroup>
</Project>
