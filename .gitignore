*.dll
*.dylib
*.ipa
*.app/
*.assets
*.resS
*.resource
*.unity3d
*.pak
*.pck
app/.build/
dist/
# Helper builds and Python packages when RECOMP_HOME is this folder
/src/
/bin/
/venv/
